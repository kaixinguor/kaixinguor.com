# /etc/kaixinguor/notify.env
# 权限必须是 600，属主 kaixinguor。至少配一个通道。
#
# Bark（iPhone；把 <key> 换成 App 里那串）
# BARK_URL=https://api.day.app/<key>/
#
# ntfy（Android/iOS/网页；topic 要随机、够长）
# NTFY_URL=https://ntfy.sh/kaixinguor-<random-topic>
# NTFY_PRIORITY=default
#
# 飞书自定义机器人
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/<token>
#
# Telegram（服务器需能访问 api.telegram.org）
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
