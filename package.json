{
  "name": "kaixinguor-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "kaixinguor.com · 三份日报（AI / 经济 / 教育）+ 工具站",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "check:links": "node scripts/check-links.mjs --latest",
    "publish": "node scripts/publish-daily.mjs",
    "stage": "node scripts/stage.mjs",
    "preview": "python3 -m http.server 8899",
    "deploy:cf": "node scripts/build.mjs && npx wrangler deploy",
    "social": "node scripts/make-social.mjs",
    "publish:ai": "node scripts/publish-daily.mjs",
    "publish:economy": "node scripts/publish-economy.mjs",
    "check:links:ai": "node scripts/check-links.mjs --latest --section ai",
    "check:links:economy": "node scripts/check-links.mjs --latest --section economy",
    "check:overlap": "node scripts/coverage.mjs check",
    "report:coverage": "node scripts/coverage.mjs report",
    "publish:education": "node scripts/publish-education.mjs",
    "check:links:education": "node scripts/check-links.mjs --latest --section education"
  },
  "engines": {
    "node": ">=20"
  }
}
