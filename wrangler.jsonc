{
  // Cloudflare Workers 部署配置（npx wrangler deploy）。
  // - 页面是静态资源：assets.directory = "."，由 .assetsignore 决定哪些不进产物
  // - 只有 /api/* 进 Worker（run_worker_first 限定），其余请求由静态资源直接响应，
  //   这样即使 Worker 出问题，页面也不会被拖下水。
  "name": "kaixinguor",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // 非密钥的运行时变量放这里；密钥（RESEND_API_KEY）用 wrangler secret put 单独存。
  // 用 Resend 的测试发件人时，发件人必须是 onboarding@resend.dev（只能发给账号本人）。
  // 换成 Cloudflare Email Sending 后，这里改回 wish-form@kaixinguor.com。
  "vars": {
    "WISH_FROM": "onboarding@resend.dev"
  }
  // 想用 Cloudflare 原生发信时，先到 Email Service → Email Sending 里 onboard 域名，
  // 再把下面这条解注释并重新部署（之后函数会自动走绑定，不需要 API token）：
  //
  // "send_email": [
  //   { "name": "EMAIL", "destination_address": "ling.wang.nj@gmail.com" }
  // ]
}
